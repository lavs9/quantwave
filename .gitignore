/target
Cargo.lock
**/*.rs.bk
.DS_Store

# bv (beads viewer) local config and caches
.bv/

# Dolt database files (added by bd init)
.dolt/
*.db

# MkDocs generated output
/site/

# Hand-authored docs are in /docs/, but some subdirectories are generated at CI time
/docs/guides/indicators/talib/
/docs/api/
/docs/SUMMARY.md

# mdBook legacy (to be removed once fully transitioned)
/docs/book/

# Temporary scratch files used during development
/scratch/
/dist/
clippy_errors*.txt
nextest_output.txt
*.traineddata
/scratch_*.py
/fix_*.py
/update_code.py
/patch_script.py
/add_docs.py
/add_plugin_docs.py
docs/examples/notebooks/rendered/

# Local verify / pre-push cache (scripts/verify_cache.py)
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class

# Compiled PyO3 extension (maturin develop drops it into the package dir)
*.abi3.so
*.so
quantwave-py/python/quantwave/*.so


# Copyrighted reference material — local only, never commit (attribution lives in docs)
/sources/
/references/*.pdf

# quantwave-wasm build output (wasm-pack)
/quantwave-wasm/pkg/
/quantwave-wasm/pkg-node/
