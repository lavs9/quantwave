"""Type stubs for quantwave.ml."""

from __future__ import annotations

from typing import Any, Dict, List, Optional, Sequence, Tuple, Union

class KanNetwork:
    def __init__(
        self,
        layers: Sequence[int],
        grid_size: int = 5,
        spline_order: int = 3,
        x_min: float = -1.0,
        x_max: float = 1.0,
    ) -> None: ...
    def forward(self, inputs: Sequence[float]) -> List[float]: ...
    def forward_batch(self, inputs: Sequence[Sequence[float]]) -> List[List[float]]: ...
    def in_features(self) -> int: ...
    def out_features(self) -> int: ...
    def num_layers(self) -> int: ...
    def extract_symbolic_formula(
        self, feature_names: Optional[Sequence[str]] = None
    ) -> str: ...
    def extract_feature_importance(
        self, feature_names: Optional[Sequence[str]] = None
    ) -> List[Dict[str, Any]]: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json_str: str) -> KanNetwork: ...

class KanIndicator:
    def __init__(self, network: KanNetwork) -> None: ...
    def next(self, input: Union[float, Sequence[float]]) -> float: ...
    def update(self, input: Union[float, Sequence[float]]) -> float: ...
    def in_features(self) -> int: ...
    def reset(self) -> None: ...
    def network(self) -> KanNetwork: ...
    def batch(self, inputs: Sequence[Sequence[float]]) -> List[float]: ...

class DifferentiableEma:
    def __init__(self, span: float = 10.0) -> None: ...
    def step(self, input: float) -> Tuple[float, float]: ...
    def next(self, input: float) -> float: ...
    @property
    def span(self) -> float: ...
    @span.setter
    def span(self, value: float) -> None: ...
    @property
    def alpha(self) -> float: ...
    @property
    def grad_span(self) -> float: ...
    @property
    def grad_alpha(self) -> float: ...
    @property
    def bars_consumed(self) -> int: ...
    def update_span(
        self,
        learning_rate: float,
        loss_gradient: float,
        min_span: float = 1.0,
        max_span: float = 100.0,
    ) -> float: ...
    def reset(self) -> None: ...
    def batch(self, inputs: Sequence[float]) -> Tuple[List[float], List[float]]: ...

class DifferentiableRsi:
    def __init__(
        self,
        span: float = 14.0,
