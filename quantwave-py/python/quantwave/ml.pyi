        oversold: float = 30.0,
        steepness: float = 0.1,
    ) -> None: ...
    def step(self, price: float) -> Tuple[float, float, float]: ...
    def next(self, price: float) -> float: ...
    @property
    def span(self) -> float: ...
    @span.setter
    def span(self, value: float) -> None: ...
    @property
    def overbought(self) -> float: ...
    @property
    def oversold(self) -> float: ...
    @property
    def steepness(self) -> float: ...
    @steepness.setter
    def steepness(self, value: float) -> None: ...
    @property
    def grad_span(self) -> float: ...
    @property
    def signal(self) -> float: ...
    @property
    def bars_consumed(self) -> int: ...
    def update_span(
        self,
        learning_rate: float,
        loss_gradient: float,
        min_span: float = 2.0,
        max_span: float = 100.0,
    ) -> float: ...
    def reset(self) -> None: ...
    def batch(
        self, prices: Sequence[float]
    ) -> Tuple[List[float], List[float], List[float]]: ...

